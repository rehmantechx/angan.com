rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOffice() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Full access', 'Staff'];
    }
    function isOfficeAnyRole() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    // Public read only for live content
    match /listings/{id} {
      allow read: if resource.data.liveStatus == 'live';
      allow create, update, delete: if isOffice();
    }
    match /projects/{id} {
      allow read: if true;
      allow create, update, delete: if isOffice();
    }
    match /blogs/{id} {
      allow read: if true;
      allow create, update, delete: if isOffice();
    }
    match /agencies/{id} {
      allow read: if true;
      allow create, update, delete: if isOffice();
    }
    match /services/{id} {
      allow read: if true;
      allow create, update, delete: if isOffice();
    }
    // Enquiries: public can create only, office can read and update stage
    match /enquiries/{id} {
      allow create: if true;
      allow read, update: if isOfficeAnyRole();
      allow delete: if isOffice();
    }
    // Users and settings: office only
    match /users/{id} {
      allow read, write: if isOfficeAnyRole();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isOffice();
    }
  }
}
