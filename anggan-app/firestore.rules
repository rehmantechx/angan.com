rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOffice() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Full access', 'Staff'];
    }
    function isOfficeAnyRole() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    // Public read only for live listings. Office can read every listing.
    // A signed-in user may create a listing only as pending (office approval
    // makes it live). Only the office can update or delete listings.
    // NOTE: the published rules had no explicit list allowance, and an
    // unfiltered list query was denied whenever any doc was not live
    // (rules are not filters). The app now queries by liveStatus, which
    // the rules can prove, but publish this file so an office list query
    // is also explicitly allowed.
    match /listings/{id} {
      allow read: if resource.data.liveStatus == 'live' || isOfficeAnyRole();
      allow list: if isOfficeAnyRole();
      allow create: if isOffice() || (isSignedIn() && request.resource.data.liveStatus == 'pending');
      allow update, delete: if isOffice();
    }
    match /projects/{id} {
      allow read: if true;
      allow create, update, delete: if isOffice();
    }
    match /blogs/{id} {
      allow read: if true;
      allow create, update, delete: if isOffice();
    }
    match /agencies/{id} {
      allow read: if true;
      allow create, update, delete: if isOffice();
    }
    match /services/{id} {
      allow read: if true;
      allow create, update, delete: if isOffice();
    }
    // Enquiries: public can create only, office can read and update stage
    // SECURITY 27 Nov 2026: create used to accept ANY document from
    // anyone, any fields, any size, so a bot could flood the enquiries
    // collection with junk or giant payloads. Now a public create must
    // be exactly the 7 fields the website form and the walk-in lead
    // modal write, with plain limits (name 2-100, phone digits 10-15,
    // asked 1-200, how 1-50, next 1-500, date YYYY-MM-DD, stage New).
    // The form already checks the phone is a real Pakistani number;
    // the rules check shape and size, which is what the server can
    // trust. Publish this file in the Firebase console for the fix to
    // take effect live.
    function validEnquiry() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'phone', 'asked', 'how', 'next', 'date', 'stage'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 100
        && d.phone is string && d.phone.size() >= 10 && d.phone.size() <= 15
        && d.phone.matches('^[0-9 +\\-()]+$')
        && d.asked is string && d.asked.size() >= 1 && d.asked.size() <= 200
        && d.how is string && d.how.size() >= 1 && d.how.size() <= 50
        && d.next is string && d.next.size() >= 1 && d.next.size() <= 500
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.stage == 'New';
    }
    match /enquiries/{id} {
      allow create: if validEnquiry();
      allow read, update: if isOfficeAnyRole();
      allow delete: if isOffice();
    }
    // Users: a signed-in user may read their own document and may create
    // their own document only as View only. The owner then raises the role
    // to Full access or Staff in the Firebase console. Only the office can
    // change or delete user documents.
    match /users/{id} {
      allow get: if isSignedIn() && (request.auth.uid == id || isOfficeAnyRole());
      allow list: if isOfficeAnyRole();
      allow create: if isSignedIn() && request.auth.uid == id && request.resource.data.role == 'View only';
      // SECURITY 25 Nov 2026: this was isOfficeAnyRole(), which let ANY
      // signed-in user with a users document (even a View-only public
      // seller) update ANY users document, including raising their own
      // role to Full access. Only the office can change or delete user
      // documents, as the comment above always said. Publish this file
      // in the Firebase console for the fix to take effect live.
      allow update, delete: if isOffice();
    }
    // Settings: public read, office write only
    match /settings/{id} {
      allow read: if true;
      allow write: if isOffice();
    }
  }
}
