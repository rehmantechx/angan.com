# Anngan Firebase config. Fill these from the Firebase console.
# Firebase console > Project settings > Your apps > Web app > SDK setup and configuration.
# Do NOT commit real values. Copy this file to .env.local and fill it in.
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_API_KEY_HERE
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID_HERE
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID_HERE
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_APP_ID_HERE

# Free photo upload (Cloudinary free tier, no card, no Blaze).
# Create a free account at cloudinary.com, then Settings > Upload >
# Upload presets > Add upload preset, Signing mode Unsigned, folder
# anngan, allowed formats jpg/png/webp, max file size 5 MB. Put the
# cloud name from the dashboard and the preset name here, in .env.local
# and in Vercel (same names). Until these two are set, photo upload in
# /admin shows the setup message and the photo link field is the fallback.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Signed photo upload (27 Nov 2026, server only, never NEXT_PUBLIC).
# Put the API key and API secret from the Cloudinary dashboard
# (Settings, API Keys) in Vercel, project anngan, Environment
# Variables, Production + Preview. They are NOT in this file and must
# never be committed: the secret signs uploads on the server, and
# anyone with it can upload to the account. After they are set in
# Vercel, change the "anngan" upload preset Signing mode to Signed in
# the Cloudinary dashboard, so unsigned uploads stop working.
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
